filters:
  and:
    - file.ext == "md"
    - not:
        - file.path.contains("/Templates/")
        - file.path.contains("/Reports/")
formulas:
  type: list(note["Note Type"]).join(", ")
  area: file.path.split("/").slice(0, 1).join("")
  edited: file.mtime.relative()
  created: file.ctime.relative()
  is_moc: list(note["Note Type"]).contains("MOC")
  p_type: if(note["Note Type"].isEmpty(), "No Note Type", if(list(note["Note Type"]).containsAny("Working", "Reference", "MOC"), "", "Invalid Note Type"))
  p_parent: if(note.Parent, "", if(formula.is_moc, "", "No Parent"))
  p_tag: if(file.tags.isEmpty(), if(formula.is_moc, "", "No tag"), "")
  p_old: if(file.hasProperty("Action"), "Old property", if(file.hasProperty("Concept"), "Old property", if(file.hasProperty("Reference"), "Old property", if(file.hasProperty("Parent MOC"), "Old property", if(file.hasProperty("Project"), "Old property", if(file.hasProperty("Domain"), "Old property", ""))))))
  p_inbox: if(file.folder.contains("Inbox"), "In Inbox", "")
  p_lonely: if(formula.is_moc, if(file.backlinks.isEmpty(), "Nothing points here", ""), "")
properties:
  formula.type:
    displayName: Note Type
  formula.area:
    displayName: Area
  formula.edited:
    displayName: Last edited
  formula.created:
    displayName: Created
  formula.p_type:
    displayName: Note Type?
  formula.p_parent:
    displayName: Parent?
  formula.p_tag:
    displayName: Tag?
  formula.p_old:
    displayName: Old props?
  formula.p_inbox:
    displayName: Inbox?
  formula.p_lonely:
    displayName: Lonely MOC?
  file.folder:
    displayName: Folder
views:
  - type: table
    name: All issues
    filters:
      or:
        - formula.p_type == "No Note Type"
        - formula.p_type == "Invalid Note Type"
        - formula.p_parent == "No Parent"
        - formula.p_tag == "No tag"
        - formula.p_old == "Old property"
        - formula.p_inbox == "In Inbox"
        - formula.p_lonely == "Nothing points here"
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - formula.p_type
      - formula.p_parent
      - formula.p_tag
      - formula.p_old
      - formula.p_inbox
      - formula.p_lonely
  - type: table
    name: Missing Note Type
    filters:
      and:
        - formula.p_type == "No Note Type"
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - file.folder
      - formula.edited
  - type: table
    name: Invalid Note Type
    filters:
      and:
        - formula.p_type == "Invalid Note Type"
    order:
      - file.name
      - formula.type
      - file.folder
  - type: table
    name: Missing Parent
    filters:
      and:
        - formula.p_parent == "No Parent"
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - formula.type
      - file.folder
  - type: table
    name: Untagged
    filters:
      and:
        - formula.p_tag == "No tag"
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - formula.type
      - file.folder
  - type: table
    name: Old properties
    filters:
      and:
        - formula.p_old == "Old property"
    order:
      - file.name
      - formula.type
      - file.folder
  - type: table
    name: Inbox backlog
    filters:
      and:
        - formula.p_inbox == "In Inbox"
    order:
      - file.name
      - file.folder
      - formula.created
      - formula.edited
    sort:
      - property: file.ctime
        direction: ASC
  - type: table
    name: Lonely MOCs
    filters:
      and:
        - formula.p_lonely == "Nothing points here"
    order:
      - file.name
      - Parent
      - file.folder
