filters:
  and:
    - file.ext == "md"
    - not:
        - file.path.contains("/Templates/")
        - file.path.contains("/Reports/")
formulas:
  type: list(note["Note Type"]).join(", ")
  area: file.path.split("/").slice(0, 1).join("")
  edited: file.mtime.relative()
  created: file.ctime.relative()
  issues: >-
    if(note["Note Type"].isEmpty(), "No Note Type · ", "")
    + if(note["Note Type"].isEmpty(), "", if(list(note["Note Type"]).containsAny("Working", "Reference", "MOC"), "", "Invalid Note Type · "))
    + if(note.Parent.isEmpty(), if(list(note["Note Type"]).contains("MOC"), "", if(file.hasTag("Daily"), "", "No Parent · ")), "")
    + if(file.tags.isEmpty(), if(list(note["Note Type"]).contains("MOC"), "", "No tag · "), "")
    + if(file.hasProperty("Action"), "Old property · ", if(file.hasProperty("Concept"), "Old property · ", if(file.hasProperty("Reference"), "Old property · ", if(file.hasProperty("Parent MOC"), "Old property · ", if(file.hasProperty("Project"), "Old property · ", if(file.hasProperty("Domain"), "Old property · ", "")))))))
    + if(file.folder.contains("Inbox"), "Still in the Inbox (run /clean-inbox) · ", "")
    + if(list(note["Note Type"]).contains("MOC"), if(file.backlinks.isEmpty(), "No notes point to this MOC · ", ""), "")
properties:
  formula.type:
    displayName: Note Type
  formula.area:
    displayName: Area
  formula.edited:
    displayName: Last edited
  formula.created:
    displayName: Created
  formula.issues:
    displayName: Problem
  file.folder:
    displayName: Folder
views:
  - type: table
    name: All issues
    filters:
      and:
        - formula.issues != ""
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - formula.issues
      - formula.type
      - file.folder
  - type: table
    name: Missing Note Type
    filters:
      and:
        - note["Note Type"].isEmpty()
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - file.folder
      - formula.edited
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 331
  - type: table
    name: Invalid Note Type
    filters:
      and:
        - not:
            - note["Note Type"].isEmpty()
        - not:
            - list(note["Note Type"]).containsAny("Working", "Reference", "MOC")
    order:
      - file.name
      - formula.type
      - file.folder
  - type: table
    name: Missing Parent
    filters:
      and:
        - note.Parent.isEmpty()
        - not:
            - list(note["Note Type"]).contains("MOC")
            - file.hasTag("Daily")
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - formula.type
      - file.folder
  - type: table
    name: Untagged
    filters:
      and:
        - file.tags.isEmpty()
        - not:
            - list(note["Note Type"]).contains("MOC")
    groupBy:
      property: formula.area
      direction: ASC
    order:
      - file.name
      - formula.type
      - file.folder
  - type: table
    name: Old properties
    filters:
      or:
        - file.hasProperty("Action")
        - file.hasProperty("Concept")
        - file.hasProperty("Reference")
        - file.hasProperty("Parent MOC")
        - file.hasProperty("Project")
        - file.hasProperty("Domain")
        - file.hasProperty("Analysis")
    order:
      - file.name
      - formula.type
      - file.folder
  - type: table
    name: Inbox backlog
    filters:
      and:
        - file.folder.contains("Inbox")
    order:
      - file.name
      - file.folder
      - formula.created
      - formula.edited
    sort:
      - property: file.ctime
        direction: ASC
  - type: table
    name: Lonely MOCs
    filters:
      and:
        - list(note["Note Type"]).contains("MOC")
        - file.backlinks.isEmpty()
    order:
      - file.name
      - Parent
      - file.folder
