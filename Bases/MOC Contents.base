filters:
  and:
    - file.hasLink(this.file)
    - file.path != this.file.path
    - not:
        - file.path.contains("/Templates/")
        - file.path.contains("/Reports/")
formulas:
  type: list(note["Note Type"]).join(", ")
  edited: file.mtime.relative()
properties:
  formula.type:
    displayName: Note Type
  formula.edited:
    displayName: Last edited
  file.folder:
    displayName: Folder
views:
  - type: table
    name: Notes here
    groupBy:
      property: formula.type
      direction: ASC
    order:
      - file.name
      - Parent
      - formula.edited
      - file.folder
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 452
      note.Parent: 277
      formula.edited: 212
  - type: table
    name: Recently edited
    order:
      - file.name
      - formula.type
      - formula.edited
    sort:
      - property: file.mtime
        direction: DESC
    limit: 10
